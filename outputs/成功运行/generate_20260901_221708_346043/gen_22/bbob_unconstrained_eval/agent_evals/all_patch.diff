+    @staticmethod
+    def _reflect(x, lb, ub):
+        """Reflect out-of-bound coordinates back into [lb, ub].
+
+        This is often better than simple clipping for BBOB functions because
+        it preserves some of the momentum/direction of the point.
+        """
+        x = np.asarray(x, dtype=float)
+        lo = np.asarray(lb, dtype=float)
+        hi = np.asarray(ub, dtype=float)
+        width = hi - lo
+        # Reflect points that are too low
+        below = x < lo
+        x = np.where(below, 2.0 * lo - x, x)
+        # Reflect points that are too high
+        above = x > hi
+        x = np.where(above, 2.0 * hi - x, x)
+        # Safety clamp (handles pathological cases where the range is tiny)
+        return np.clip(x, lo, hi)
+
