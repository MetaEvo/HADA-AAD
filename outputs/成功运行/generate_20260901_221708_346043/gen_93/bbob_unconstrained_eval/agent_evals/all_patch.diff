+class SHADEProgressController(ParamController):
+    """Improved SHADE-style parameter controller.
+
+    Uses smooth progress-based F/CR scheduling with a memory-like adaptive
+    component and stagnation-sensitive diversity boosts. This controller is
+    designed specifically for the L-SHADE/JADE optimizer in ec_algorithm.py.
+    """
+    def __init__(self, f_start=0.9, f_end=0.25, cr_start=0.95, cr_end=0.4,
+                 stagnation_boost=0.15, boost_decay=0.9):
+        self.f_start = f_start
+        self.f_end = f_end
+        self.cr_start = cr_start
+        self.cr_end = cr_end
+        self.stagnation_boost = stagnation_boost
+        self.boost_decay = boost_decay
+
+    def reset(self, problem_meta: Dict[str, Any]) -> None:
+        self.it = 0
+        self.last_gbest = None
+        self.stagnation_count = 0
+        self.active_boost = 0.0
+
+    def step(self, observation: Dict[str, Any]) -> Dict[str, float]:
+        self.it = observation.get('iteration', self.it + 1)
+        max_evals = int(observation.get('max_evals', 10000))
+        evals = int(observation.get('evals', 0))
+        # Max iterations is estimated based on population size if available
+        pop_size = int(observation.get('pop_size', 40))
+        max_iter = max(1, int(max_evals / max(1, pop_size)))
+        t = min(1.0, float(self.it) / max_iter)
+        # Also use evaluation progress for smoother transition
+        t_evals = min(1.0, evals / max(1, max_evals))
+        t = 0.6 * t + 0.4 * t_evals
+
+        # Baseline schedule with cosine-like ease
+        F = self.f_end + (self.f_start - self.f_end) * (1.0 - t) ** 1.0
+        CR = self.cr_end + (self.cr_start - self.cr_end) * (1.0 - t) ** 0.85
+
+        # Use stagnation info provided by the optimizer if available
+        current_gbest = observation.get('gbest_f', None)
+        obs_stagnation = int(observation.get('stagnation_count', 0))
+        if obs_stagnation > 0:
+            self.stagnation_count = obs_stagnation
+        elif current_gbest is not None and self.last_gbest is not None:
+            if current_gbest < self.last_gbest - 1e-12:
+                self.stagnation_count = 0
+            else:
+                self.stagnation_count += 1
+        if current_gbest is not None:
+            self.last_gbest = current_gbest
+
+        # Increase diversity as stagnation grows
+        if self.stagnation_count >= 5:
+            boost_factor = min(1.0, (self.stagnation_count - 4) / 10.0)
+            self.active_boost = self.stagnation_boost * boost_factor
+        else:
+            self.active_boost = max(0.0, self.active_boost * self.boost_decay)
+
+        F = min(1.0, F + self.active_boost)
+        CR = min(1.0, CR + self.active_boost * 0.7)
+
+        # Late-stage refinement: keep F moderate but not too small
+        if t > 0.8:
+            F = max(F, 0.15)
+
+        return {'F': float(F), 'CR': float(CR)}
+
+
