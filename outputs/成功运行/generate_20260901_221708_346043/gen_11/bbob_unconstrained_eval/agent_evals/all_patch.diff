+class LSHADEHeuristicController(ParamController):
+    """A simple L-SHADE-friendly controller.
+
+    Shrinks F and CR over the run, boosts diversity on stagnation,
+    and provides pbest_p / linear_reduction hints for the optimizer.
+    """
+    def __init__(self, f_start=0.85, f_end=0.25, cr_start=0.95, cr_end=0.45,
+                 stagnation_boost=0.25):
+        self.f_start = f_start
+        self.f_end = f_end
+        self.cr_start = cr_start
+        self.cr_end = cr_end
+        self.stagnation_boost = stagnation_boost
+
+    def reset(self, problem_meta: Dict[str, Any]) -> None:
+        self.it = 0
+        self.last_gbest = None
+        self.stagnation_count = 0
+
+    def step(self, observation: Dict[str, Any]) -> Dict[str, float]:
+        self.it = observation.get('iteration', self.it + 1)
+        pop_size = int(observation.get('pop_size', 40))
+        max_evals = float(observation.get('max_evals', 10000))
+        max_iter = max(1, int(max_evals / max(1, pop_size)))
+        t = min(1.0, float(self.it) / max_iter)
+
+        F = self.f_start + (self.f_end - self.f_start) * t
+        CR = self.cr_start + (self.cr_end - self.cr_start) * t
+
+        current_gbest = observation.get('gbest_f', None)
+        if current_gbest is not None and self.last_gbest is not None:
+            if current_gbest < self.last_gbest - 1e-12:
+                self.stagnation_count = 0
+            else:
+                self.stagnation_count += 1
+        self.last_gbest = current_gbest
+
+        if self.stagnation_count > 5:
+            F = min(1.0, F + self.stagnation_boost)
+            CR = min(1.0, CR + self.stagnation_boost)
+            self.stagnation_count = 0
+
+        pbest_p = max(0.05, 0.2 * (1.0 - t))
+        return {'F': float(F), 'CR': float(CR), 'pbest_p': float(pbest_p)}
