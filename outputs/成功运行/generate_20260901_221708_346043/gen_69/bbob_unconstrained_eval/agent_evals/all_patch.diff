+    def _reflect(self, x, lb, ub, rng):
+        """Reflect out-of-bound values back into [lb, ub] with a random fallback.
+
+        Modulo-based reflection maps any real value into the feasible box while
+        preserving the periodicity of the search space; for degenerate cases it
+        falls back to uniform sampling inside the box.
+        """
+        y = x.copy()
+        for j in range(self.dim):
+            lo = float(lb[j])
+            hi = float(ub[j])
+            span = hi - lo
+            if span <= 0.0:
