+            elif y[j] < lo:
+                offset = (lo - y[j]) % span
+                y[j] = lo + offset
+                if y[j] < lo or y[j] > hi:
+                    y[j] = lo + rng.random() * span
+            elif y[j] > hi:
+                offset = (y[j] - hi) % span
+                y[j] = hi - offset
+                if y[j] < lo or y[j] > hi:
+                    y[j] = lo + rng.random() * span
+        return y
