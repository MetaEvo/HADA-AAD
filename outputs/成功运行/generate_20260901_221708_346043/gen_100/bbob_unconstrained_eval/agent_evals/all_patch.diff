+def latin_hypercube_sampling(n, dim, lb, ub, rng):
+    """Generate a Latin Hypercube Sample of size n in [lb, ub]^dim."""
+    samples = np.zeros((n, dim))
+    for j in range(dim):
+        # Stratified random sampling in each dimension
+        u = (np.arange(n) + rng.rand(n)) / n
+        rng.shuffle(u)
+        samples[:, j] = lb[j] + u * (ub[j] - lb[j])
+    return samples
+
