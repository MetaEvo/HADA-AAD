+class AdaptiveSHADEController(ParamController):
+    """A refined progress-and-stagnation-aware controller for SHADE algorithms.
+
+    It provides F and CR values that decay smoothly from exploratory to
+    exploitative as the evaluation budget is consumed.  It also detects
+    stagnation (no improvement of the global best for several steps) and
+    temporarily boosts diversity to escape local optima.  Additionally, it
+    exposes a `pbest_p` parameter that the optimizer may use to control the
+    size of the pbest set in current-to-pbest/1 mutation.
+    """
+    def __init__(self, f_start=0.9, f_end=0.3, cr_start=0.9, cr_end=0.4,
+                 stagnation_boost=0.15, boost_steps=3):
+        self.f_start = f_start
+        self.f_end = f_end
+        self.cr_start = cr_start
+        self.cr_end = cr_end
+        self.stagnation_boost = stagnation_boost
+        self.boost_steps = boost_steps
+
+    def reset(self, problem_meta: Dict[str, Any]) -> None:
+        self.it = 0
+        self.last_gbest = None
+        self.stagnation_count = 0
+        self.boost_left = 0
+
+    def step(self, observation: Dict[str, Any]) -> Dict[str, float]:
+        self.it = observation.get('iteration', self.it + 1)
+        evals = float(observation.get('evals', 0))
+        max_evals = float(observation.get('max_evals', 10000))
+        t = min(1.0, evals / max(1.0, max_evals))
+
+        # Smooth exploration -> exploitation schedule
+        F = self.f_start * (1.0 - t) + self.f_end * t
+        CR = self.cr_start * (1.0 - t) + self.cr_end * t
+
+        # Detect stagnation / improvement
+        current_gbest = observation.get('gbest_f', None)
+        if current_gbest is not None and self.last_gbest is not None:
+            if current_gbest < self.last_gbest - 1e-15:
+                self.stagnation_count = 0
+            else:
+                self.stagnation_count += 1
+        self.last_gbest = current_gbest
+
+        # Boost diversity after several consecutive non-improving steps
+        if self.stagnation_count >= self.boost_steps:
+            self.boost_left = 2
+            self.stagnation_count = 0
+        if self.boost_left > 0:
+            F = min(1.0, F + self.stagnation_boost)
+            CR = min(1.0, CR + self.stagnation_boost)
+            self.boost_left -= 1
+
+        # Smaller pbest set late in the run for more exploitation
+        pbest_p = max(0.05, min(0.25, 0.20 * (1.0 - t)))
+
+        return {'F': float(F), 'CR': float(CR), 'pbest_p': float(pbest_p),
+                'strategy': 'shade'}
