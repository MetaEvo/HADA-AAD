+    def _latin_hypercube(self, rng, lb, ub, n):
+        """Generate a Latin hypercube sample in [lb, ub].
+
+        This gives much better initial coverage than plain uniform sampling,
+        especially for high-dimensional problems, and reduces the risk of the
+        population starting in an unprepared corner of the search space.
+        """
+        lb = np.asarray(lb, dtype=float)
+        ub = np.asarray(ub, dtype=float)
+        dim = len(lb)
+        samples = np.zeros((n, dim))
+        for d in range(dim):
+            perm = rng.permutation(n)
+            u = (perm + rng.random(n)) / n
+            samples[:, d] = lb[d] + u * (ub[d] - lb[d])
+        return samples
+
