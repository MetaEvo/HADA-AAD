+class JADEAdaptiveController(ParamController):
+    """Adaptive controller tuned for JADE: exploration-to-exploitation decay
+    with stagnation detection and late-run CR refinement."""
+    def __init__(self, f_start=0.9, f_end=0.2, cr_start=0.9, cr_end=0.3,
+                 stagnation_boost=0.15, patience=8):
+        self.f_start = f_start
+        self.f_end = f_end
+        self.cr_start = cr_start
+        self.cr_end = cr_end
+        self.stagnation_boost = stagnation_boost
+        self.patience = patience
+
+    def reset(self, problem_meta: Dict[str, Any]) -> None:
+        self.it = 0
+        self.last_gbest = None
+        self.stagnation_count = 0
+
+    def step(self, observation: Dict[str, Any]) -> Dict[str, float]:
+        self.it = observation.get('iteration', self.it + 1)
+        max_iters = max(1, int(observation.get('max_evals', 10000) / 50))
+        t = min(1.0, float(self.it) / max_iters)
+
+        # Smooth transition from exploration to exploitation
+        F = self.f_start * (1.0 - t) + self.f_end * t
+        CR = self.cr_start * (1.0 - t) + self.cr_end * t
+
+        current_gbest = observation.get('gbest_f', None)
+        if current_gbest is not None and self.last_gbest is not None:
+            if current_gbest < self.last_gbest - 1e-12:
+                self.stagnation_count = 0
+            else:
+                self.stagnation_count += 1
+        self.last_gbest = current_gbest
+
+        # If no improvement for `patience` iterations, boost diversity
+        if self.stagnation_count >= self.patience:
+            F = min(1.0, F + self.stagnation_boost)
+            CR = min(1.0, CR + self.stagnation_boost)
+            self.stagnation_count = 0
+
+        # Late-stage refinement: reduce CR to retain good building blocks
+        if t > 0.85:
+            CR = min(CR, 0.35)
+
+        return {'F': float(F), 'CR': float(CR), 'strategy': 'jade'}
+
+
