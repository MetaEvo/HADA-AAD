+class EnhancedSHADEController(ParamController):
+    """A more aggressive, dimension-aware SHADE/L-SHADE controller.
+
+    Compared to `AdaptiveDEController`, this controller:
+    - Keeps F higher for longer, which is helpful for high-dimensional
+      problems where larger mutation steps accelerate exploration.
+    - Uses a faster CR decay, preserving useful building blocks sooner.
+    - Adapts the elite fraction `pbest_p` non-linearly, allowing strong
+      exploitation near the end of the budget.
+    - Reacts immediately to stagnation by boosting both F and CR.
+    """
+    def __init__(self, min_F=0.25, max_F=1.0, min_CR=0.2, max_CR=1.0,
+                 stagnation_boost=0.25, stagnation_patience=4):
+        self.min_F = min_F
+        self.max_F = max_F
+        self.min_CR = min_CR
+        self.max_CR = max_CR
+        self.stagnation_boost = stagnation_boost
+        self.stagnation_patience = stagnation_patience
+
+    def reset(self, problem_meta: Dict[str, Any]) -> None:
+        self.it = 0
+        self.last_gbest = None
+        self.stagnation_count = 0
+        self.dim = int(problem_meta.get('dim', 10))
+
+    def step(self, observation: Dict[str, Any]) -> Dict[str, float]:
+        self.it = observation.get('iteration', self.it + 1)
+        max_evals = float(observation.get('max_evals', 10000))
+        evals = float(observation.get('evals', 0))
+        t = min(1.0, evals / max(1.0, max_evals))
+
+        # Dimension-aware exploration: larger dimension needs higher F longer.
+        dim_factor = min(1.5, 0.8 + 0.02 * self.dim)
+        F = self.max_F - (self.max_F - self.min_F) * (t ** (1.6 / dim_factor))
+
+        # Faster CR decay to exploit good schemata earlier.
+        CR = self.max_CR - (self.max_CR - self.min_CR) * (t ** 1.2)
+
+        # Stagnation detection and reactive boost.
+        current = observation.get('gbest_f', None)
+        if current is not None and self.last_gbest is not None:
+            if current < self.last_gbest - 1e-12:
+                self.stagnation_count = 0
+            else:
+                self.stagnation_count += 1
+        self.last_gbest = current
+        if self.stagnation_count >= self.stagnation_patience:
+            F = min(self.max_F, F + self.stagnation_boost)
+            CR = min(self.max_CR, CR + self.stagnation_boost)
+            self.stagnation_count = 0
+
+        # Strong elite exploitation late in the run.
+        pbest_p = 0.4 * (1.0 - t) ** 1.5 + 0.02
+
+        return {'F': float(F), 'CR': float(CR), 'pbest_p': float(pbest_p),
+                'strategy': 'jade' if t > 0.25 else 'rand/1'}
