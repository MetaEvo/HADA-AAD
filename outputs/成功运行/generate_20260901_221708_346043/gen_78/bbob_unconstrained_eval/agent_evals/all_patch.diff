+class SHADEController(ParamController):
+    """SHADE-inspired adaptive controller for DE.
+
+    Maintains a small memory of successful F/CR values and adapts
+    per-generation parameter sampling around those memories.
+    The controller combines the SHADE memory with a progress-based
+    exploration/exploitation schedule.
+    """
+    def __init__(self, memory_size=5, f_start=0.9, f_end=0.3,
+                 cr_start=0.9, cr_end=0.3, stagnation_boost=0.15):
+        self.memory_size = max(1, int(memory_size))
+        self.f_start = f_start
+        self.f_end = f_end
+        self.cr_start = cr_start
+        self.cr_end = cr_end
+        self.stagnation_boost = stagnation_boost
+
+    def reset(self, problem_meta: Dict[str, Any]) -> None:
+        self.it = 0
+        self.mem_idx = 0
+        self.M_F = [0.5] * self.memory_size
+        self.M_CR = [0.5] * self.memory_size
+        self.last_gbest = None
+        self.stagnation_count = 0
+
+    def step(self, observation: Dict[str, Any]) -> Dict[str, float]:
+        self.it = observation.get('iteration', self.it + 1)
+        max_iter = max(1, int(observation.get('max_evals', 10000) / 100))
+        t = min(1.0, float(self.it) / max_iter)
+
+        # Progress-aware base schedule: if still far from initial fitness,
+        # keep more exploration even late in the run; if very close, exploit.
+        gbest = observation.get('gbest_f', None)
+        init_gbest = observation.get('initial_gbest_f', None)
+        if gbest is not None and init_gbest is not None and abs(init_gbest - gbest) > 1e-12:
+            # Normalized relative improvement in [0, 1]
+            rel_improve = (init_gbest - gbest) / abs(init_gbest) if abs(init_gbest) > 1e-12 else 0.0
+            rel_improve = float(max(0.0, min(1.0, rel_improve)))
+        else:
+            rel_improve = 0.0
+
+        # Early / far-from-optimum -> explore; late / close -> exploit
+        F_base = self.f_start * (1 - t) * (1.0 - 0.5 * rel_improve) + self.f_end * t * (1.0 + rel_improve)
+        CR_base = self.cr_start * (1 - t) * (1.0 - 0.3 * rel_improve) + self.cr_end * t * (1.0 + rel_improve)
+        F_base = float(max(0.1, min(1.0, F_base)))
+        CR_base = float(max(0.0, min(1.0, CR_base)))
+
+        # Stagnation detection: boost diversity if no improvement for several iterations
+        if gbest is not None and self.last_gbest is not None:
+            if gbest < self.last_gbest - 1e-12:
+                self.stagnation_count = 0
+            else:
+                self.stagnation_count += 1
+        self.last_gbest = gbest
+
+        if self.stagnation_count > 5:
+            F_base = min(1.0, F_base + self.stagnation_boost)
+            CR_base = min(1.0, CR_base + self.stagnation_boost)
+            self.stagnation_count = 0
+
+        # Pick a memory slot and blend with the scheduled base
+        mem_k = self.it % self.memory_size
+        F = 0.6 * float(self.M_F[mem_k]) + 0.4 * F_base
+        CR = 0.7 * float(self.M_CR[mem_k]) + 0.3 * CR_base
+        F = float(max(0.1, min(1.0, F)))
+        CR = float(max(0.0, min(1.0, CR)))
+
+        return {'F': F, 'CR': CR, 'strategy': 'shade'}
+
+    def update_memory(self, successful_F, successful_CR):
+        """Update the memory with successful parameters after a generation.
+
+        This method is optional and can be called by the optimizer when
+        per-individual successful parameters are available.
+        """
+        if successful_F:
+            self.M_F[self.mem_idx] = float(np.mean(successful_F))
+            self.M_CR[self.mem_idx] = float(np.mean(successful_CR))
+            self.mem_idx = (self.mem_idx + 1) % self.memory_size
