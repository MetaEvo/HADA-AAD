+class ImprovedDEController(ParamController):
+    """Progress-aware DE/JADE controller with dynamic p-best and stagnation recovery.
+
+    This controller is designed for the current-to-pbest/1 mutation used by the
+    JADE/SHADE optimizer in ec_algorithm.py. It:
+      - anneals F from high to low for exploration->exploitation;
+      - keeps CR moderately high to maintain diversity;
+      - dynamically shrinks p_best to focus on elites as the budget is consumed;
+      - detects stagnation and temporarily boosts exploration.
+    """
+    def __init__(self, f_start=0.9, f_end=0.25, cr_start=0.9, cr_end=0.5,
+                 p_best_start=0.3, p_best_end=0.05,
+                 stagnation_threshold=6, stagnation_boost=0.25):
+        self.f_start = f_start
+        self.f_end = f_end
+        self.cr_start = cr_start
+        self.cr_end = cr_end
+        self.p_best_start = p_best_start
+        self.p_best_end = p_best_end
+        self.stagnation_threshold = stagnation_threshold
+        self.stagnation_boost = stagnation_boost
+        self.it = 0
+        self.last_gbest = None
+        self.stagnation_count = 0
+
+    def reset(self, problem_meta):
+        self.it = 0
+        self.last_gbest = None
+        self.stagnation_count = 0
+
+    def step(self, observation):
+        self.it = observation.get('iteration', self.it + 1)
+        max_evals = float(observation.get('max_evals', 10000))
+        evals = float(observation.get('evals', 0))
+        progress = min(1.0, evals / max(1.0, max_evals))
+
+        F = self.f_start * (1.0 - progress) + self.f_end * progress
+        CR = self.cr_start * (1.0 - progress) + self.cr_end * progress
+        p_best = self.p_best_start * (1.0 - progress) + self.p_best_end * progress
+
+        current_gbest = observation.get('gbest_f', None)
+        if current_gbest is not None and self.last_gbest is not None:
+            if current_gbest < self.last_gbest - 1e-12:
+                self.stagnation_count = 0
+            else:
+                self.stagnation_count += 1
+        self.last_gbest = current_gbest
+
+        if self.stagnation_count >= self.stagnation_threshold:
+            F = min(1.0, F + self.stagnation_boost)
+            CR = min(1.0, CR + self.stagnation_boost)
+            p_best = min(0.5, p_best + 0.1)
+            self.stagnation_count = 0
+
+        return {'F': float(F), 'CR': float(CR), 'p_best': float(p_best)}
