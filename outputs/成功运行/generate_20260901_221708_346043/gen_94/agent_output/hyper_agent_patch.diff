+"""Complete reference L-SHADE (drop-in replacement for ec_algorithm.py)."""
+from typing import Optional, Dict, Any, Tuple
+import numpy as np
+import os, sys
+
+_config_seed = None
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from config import SEED as _config_seed
+
+
+def evaluate_problem(problem, x):
+    if not isinstance(x, np.ndarray): x = np.asarray(x, dtype=float)
+    if hasattr(problem, 'func'):
+        if x.ndim == 1: x = x.reshape(1, -1)
+        return float(np.mean(np.array(problem.func(x)).flatten()))
+    return float(problem(x))
+
+
+class DEOptimizer:
+    """Vectorized L-SHADE optimizer."""
+    def __init__(self, dim, lower_bounds, upper_bounds, max_evals,
+                 params=None, controller=None, recorder=None, swarm_size=None):
+        self.dim = int(dim); self.max_evals = int(max_evals)
+        self.params = dict(params) if params is not None else {}
+        self.controller = controller; self.recorder = recorder; self.stats = {}
+        self.pop_size = int(swarm_size) if swarm_size is not None else 40
+        self.F = float(self.params.get('F', 0.7)); self.CR = float(self.params.get('CR', 0.5))
+        lb = np.asarray(lower_bounds, dtype=float); ub = np.asarray(upper_bounds, dtype=float)
+        if lb.ndim == 0: lb = np.full(self.dim, float(lb))
+        if ub.ndim == 0: ub = np.full(self.dim, float(ub))
+        self.lb = lb; self.ub = ub
+
+    def optimize(self, problem, x0=None, train=True, seed=None):
+        dim, lb, ub = self.dim, self.lb, self.ub
+        ps = self.pop_size
+        rng = np.random.RandomState(seed if seed is not None else _config_seed)
+        pop = rng.uniform(lb, ub, (ps, dim))
+        evals = 0; fit = np.full(ps, np.inf)
+        for i in range(ps):
+            if evals >= self.max_evals: break
+            fit[i] = evaluate_problem(problem, pop[i]); evals += 1
+        bi = int(np.argmin(fit)); gbest_f = float(fit[bi]); gbest = pop[bi].copy()
+        init_f = gbest_f; prev_f = gbest_f
+
+        msize = 10; mF = np.full(msize, 0.7); mCR = np.full(msize, 0.5); midx = 0
+        archive = np.empty((0, dim)); arcap = max(ps*2, 60)
+        p_init = ps; p_cur = ps; p_min = max(4, int(0.15*ps)); stag = 0; it = 0
+
+        while evals < self.max_evals:
+            it += 1
+            params = dict(self.params)
+            if self.controller is not None:
+                obs = {'iteration': it, 'evals': evals, 'gbest_f': gbest_f,
+                       'initial_gbest_f': init_f, 'max_evals': self.max_evals}
+                sp = self.controller.step(obs)
+                if isinstance(sp, dict): params.update(sp)
+            bF = float(params.get('F', self.F)); bCR = float(params.get('CR', self.CR))
+
+            prog = min(1.0, evals / max(1, self.max_evals))
+            target = max(p_min, int(round(p_init + (p_min - p_init)*prog)))
+            if target < p_cur:
+                ki = np.argsort(fit)[:target]
+                pop = pop[ki].copy(); fit = fit[ki]; p_cur = target
+
+            p = max(0.05, 0.2*(1.0-prog)); npb = max(2, int(p_cur*p))
+            sidx = np.argsort(fit)[:npb]
+
+            mi = rng.randint(0, msize, size=p_cur)
+            F_i = np.clip(mF[mi] + 0.1*rng.standard_cauchy(p_cur), 0.1, 1.0)
+            CR_i = np.clip(mCR[mi] + 0.1*rng.randn(p_cur), 0.0, 1.0)
+            if self.controller is not None:
+                F_i = np.clip(0.7*F_i + 0.3*bF, 0.05, 1.0)
+                CR_i = np.clip(0.7*CR_i + 0.3*bCR, 0.0, 1.0)
+
+            pbi = sidx[rng.randint(0, npb, size=p_cur)]
+            r1 = rng.randint(0, p_cur, size=p_cur)
+            same = (r1 == np.arange(p_cur))
+            while np.any(same):
+                r1[same] = rng.randint(0, p_cur, size=int(np.sum(same))); same = (r1 == np.arange(p_cur))
+            na = len(archive); tp = p_cur + na
+            r2 = rng.randint(0, max(1,tp), size=p_cur)
+            if tp > 0:
+                bad = (r2 < p_cur) & ((r2 == np.arange(p_cur)) | (r2 == r1))
+                while np.any(bad):
+                    r2[bad] = rng.randint(0, max(1,tp), size=int(np.sum(bad))); bad = (r2 < p_cur) & ((r2 == np.arange(p_cur)) | (r2 == r1))
+            pa = np.vstack([pop, archive]) if na > 0 else pop
+            xr2 = pa[np.minimum(r2, len(pa)-1)]
+
+            mut = pop + F_i[:,None]*(pop[pbi]-pop) + F_i[:,None]*(pop[r1]-xr2)
+            for _ in range(5):
+                lo = mut < lb; hi = mut > ub
+                if not np.any(lo) and not np.any(hi): break
+                mut = np.where(lo, 2*lb-mut, np.where(hi, 2*ub-mut, mut))
+            mut = np.clip(mut, lb, ub)
+
+            jr = rng.randint(0, dim, size=p_cur)
+            mk = rng.random((p_cur, dim)) < CR_i[:,None]
+            mk[np.arange(p_cur), jr] = True
+            trial = np.where(mk, mut, pop)
+
+            SF, SC, SD = [], [], []
+            for i in range(p_cur):
+                if evals >= self.max_evals: break
+                tf = evaluate_problem(problem, trial[i]); evals += 1
+                if tf < fit[i]:
+                    SF.append(float(F_i[i])); SC.append(float(CR_i[i])); SD.append(float(fit[i]-tf))
+                    if len(archive) < arcap: archive = np.vstack([archive, pop[i].reshape(1,-1)])
+                    else: archive[rng.randint(0, arcap)] = pop[i]
+                    pop[i] = trial[i]; fit[i] = tf
+                    if tf < gbest_f: gbest_f = tf; gbest = trial[i].copy()
+
+            if len(SF) > 0:
+                SFa = np.array(SF); SCa = np.array(SC); SDa = np.array(SD)
+                td = float(np.sum(SDa))
+                w = SDa/td if td > 1e-30 else np.ones_like(SDa)/len(SDa)
+                mf = float(np.sum(w*SFa**2)/np.sum(w*SFa)) if np.sum(w*SFa) > 1e-30 else float(np.mean(SFa))
+                mc = float(np.sum(w*SCa))
+                mF[midx] = max(0.1, min(1.0, mf)); mCR[midx] = max(0.0, min(1.0, mc))
+                midx = (midx+1) % msize
+
+            if gbest_f < prev_f - 1e-12: stag = 0
+            else:
+                stag += 1
+                if stag >= 5:
+                    nr = max(1, int(p_cur*0.15)); wi = np.argsort(fit)[-nr:]
+                    sig = (ub-lb)*0.02*(1.0+prog)
+                    for idx in wi:
+                        if evals >= self.max_evals: break
+                        pop[idx] = np.clip(gbest + sig*rng.standard_normal(dim), lb, ub)
+                        fit[idx] = evaluate_problem(problem, pop[idx]); evals += 1
+                    stag = 0
+
+            if self.controller is not None and train:
+                imp = 1.0 if gbest_f < prev_f else 0.0
+                nobs = {'iteration': it, 'evals': evals, 'gbest_f': gbest_f,
+                        'initial_gbest_f': init_f, 'max_evals': self.max_evals}
+                if hasattr(self.controller, 'store_reward'):
+                    self.controller.store_reward(imp, nobs, evals >= self.max_evals)
+            prev_f = gbest_f
+
+        self.stats = {'gbest': gbest.tolist(), 'gbest_f': float(gbest_f), 'evals': int(evals),
+                      'iterations': int(it), 'initial_gbest_f': float(init_f)}
+        return gbest.tolist(), self.stats
