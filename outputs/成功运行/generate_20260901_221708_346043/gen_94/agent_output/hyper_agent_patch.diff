+"""Reference JADE implementation compatible with the DEOptimizer interface.
+
+This file provides a COMPLETE, syntactically valid JADE optimizer that can be
+copied into ec_algorithm.py. It is provided as a reference template because
+partial edits to the existing DE loop often result in broken syntax.
+
+JADE: Adaptive Differential Evolution with Optional External Archive
+Reference: Zhang & Sanderson (2009)
+"""
+
+from typing import Optional, Dict, Any, Tuple
+import numpy as np
+import os
+import sys
+
+_config_seed = None
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from config import SEED as _config_seed
+
+
+def evaluate_problem(problem, x):
+    """Evaluate problem, handling both MetaBox (problem.func) and cocoex (problem(x)) styles."""
+    if not isinstance(x, np.ndarray):
+        x = np.asarray(x, dtype=float)
+
+    if hasattr(problem, 'func'):
+        if x.ndim == 1:
+            x = x.reshape(1, -1)
+        result = problem.func(x)
+        return float(np.mean(np.array(result).flatten()))
+    else:
+        return float(problem(x))
+
+
+class DEOptimizer:
+    """JADE optimizer with the same interface as the original DEOptimizer."""
+
+    def __init__(self, dim, lower_bounds, upper_bounds, max_evals,
+                 params=None, controller=None, recorder=None, swarm_size=None):
+        self.dim = int(dim)
+        self.max_evals = int(max_evals)
+        self.params = dict(params) if params is not None else {}
+        self.controller = controller
+        self.recorder = recorder
+        self.stats = {}
+        # Default pop size 40 to match evaluator, or use swarm_size
+        self.pop_size = int(swarm_size) if swarm_size is not None else 40
+        # F and CR defaults
+        self.F = float(self.params.get('F', 0.7))
+        self.CR = float(self.params.get('CR', 0.5))
+
+        # Bounds
+        lb = np.asarray(lower_bounds, dtype=float)
+        ub = np.asarray(upper_bounds, dtype=float)
+        if lb.ndim == 0:
+            lb = np.full(self.dim, float(lb))
+        if ub.ndim == 0:
+            ub = np.full(self.dim, float(ub))
+        self.lb = lb
+        self.ub = ub
+
+    def optimize(self, problem, x0=None, train=True, seed=None):
+        """Run JADE until max_evals is reached.
+
+        Returns:
+            (gbest_list, stats_dict)
+        """
+        dim = self.dim
+        lb = self.lb
+        ub = self.ub
+        pop_size = self.pop_size
+
+        effective_seed = seed if seed is not None else _config_seed
+        rng = np.random.RandomState(effective_seed)
+
+        # ---- Initialization ----
+        pop = rng.uniform(lb, ub, (pop_size, dim))
+        if x0 is not None:
+            x0_arr = np.asarray(x0, dtype=float).flatten()
+            if x0_arr.shape[0] == dim:
+                pop[0] = np.clip(x0_arr, lb, ub)
+
+        evals = 0
+        fitness = np.full(pop_size, np.inf)
+        for i in range(pop_size):
+            if evals >= self.max_evals:
+                break
+            fitness[i] = evaluate_problem(problem, pop[i])
+            evals += 1
+
+        best_idx = int(np.argmin(fitness))
+        gbest_f = float(fitness[best_idx])
+        gbest = pop[best_idx].copy()
+        initial_gbest_f = float(gbest_f)
+        prev_gbest_f = gbest_f
+
+        # ---- JADE memory and archive ----
+        archive = np.empty((0, dim), dtype=float)
+        archive_capacity = max(pop_size * 2, 20)
+        mu_F = float(self.F)
+        mu_CR = float(self.CR)
+        c = 0.1
+
+        iteration = 0
+        while evals < self.max_evals:
+            iteration += 1
+
+            # Controller-provided F/CR are blended into the adaptation memory
+            params = dict(self.params)
+            if self.controller is not None:
+                obs = {'iteration': iteration, 'evals': evals, 'gbest_f': gbest_f,
+                       'initial_gbest_f': initial_gbest_f, 'max_evals': self.max_evals}
+                step_params = self.controller.step(obs)
+                if isinstance(step_params, dict):
+                    params.update(step_params)
+            base_F = float(params.get('F', self.F))
+            base_CR = float(params.get('CR', self.CR))
+            base_F = min(1.0, max(0.0, 0.5 * base_F + 0.5 * mu_F))
+            base_CR = min(1.0, max(0.0, 0.5 * base_CR + 0.5 * mu_CR))
+
+            # p-best selection pool (shrinks as budget is consumed)
+            progress = evals / max(1, self.max_evals)
+            p = max(0.05, 0.2 * (1.0 - progress))
+            n_pbest = max(2, int(pop_size * p))
+            sorted_idx = np.argsort(fitness)
+
+            # Archive + population pool for x_r2
+            archive_pop = np.vstack([pop, archive]) if len(archive) > 0 else pop
+            n_arch = len(archive_pop)
+
+            new_pop = np.copy(pop)
+            S_F = []
+            S_CR = []
+
+            for i in range(pop_size):
+                # F_i drawn from Cauchy around mu_F, truncated
+                F_i = base_F + 0.1 * rng.standard_cauchy()
+                F_i = float(np.clip(F_i, 0.1, 1.0))
+                # CR_i drawn from Normal around mu_CR, truncated
+                CR_i = base_CR + 0.1 * rng.randn()
+                CR_i = float(np.clip(CR_i, 0.0, 1.0))
+
+                # Current-to-pbest/1 mutation
+                pbest_idx = sorted_idx[rng.randint(0, n_pbest)]
+                r1 = rng.randint(0, pop_size)
+                while r1 == i:
+                    r1 = rng.randint(0, pop_size)
+                if n_arch > 1:
+                    r2 = rng.randint(0, n_arch)
+                    x_r2 = archive_pop[r2]
+                else:
+                    r2 = rng.randint(0, pop_size)
+                    while r2 == i or r2 == r1:
+                        r2 = rng.randint(0, pop_size)
+                    x_r2 = pop[r2]
+
+                mutant = pop[i] + F_i * (pop[pbest_idx] - pop[i]) + F_i * (pop[r1] - x_r2)
+
+                # Boundary repair: reflect
+                for _ in range(5):
+                    below = mutant < lb
+                    above = mutant > ub
+                    if not np.any(below) and not np.any(above):
+                        break
+                    mutant = np.where(below, 2 * lb - mutant, mutant)
+                    mutant = np.where(above, 2 * ub - mutant, mutant)
+                mutant = np.clip(mutant, lb, ub)
+
+                # Binomial crossover
+                j_rand = rng.randint(0, dim)
+                mask = rng.random(dim) < CR_i
+                mask[j_rand] = True
+                trial = np.where(mask, mutant, pop[i])
+
+                # Evaluation and selection
+                if evals >= self.max_evals:
+                    break
+                trial_f = evaluate_problem(problem, trial)
+                evals += 1
+
+                if trial_f < fitness[i]:
+                    # Save the replaced individual to the external archive
+                    if len(archive) < archive_capacity:
+                        archive = np.vstack([archive, pop[i].reshape(1, -1)])
+                    else:
+                        ridx = rng.randint(0, archive_capacity)
+                        archive[ridx] = pop[i]
+                    new_pop[i] = trial
+                    fitness[i] = trial_f
+                    S_F.append(F_i)
+                    S_CR.append(CR_i)
+                    if trial_f < gbest_f:
+                        gbest_f = trial_f
+                        gbest = trial.copy()
+
+            pop = new_pop
+
+            # Update success-history memory (Lehmer mean for F, arithmetic for CR)
+            if len(S_F) > 0:
+                S_F_arr = np.array(S_F)
+                S_CR_arr = np.array(S_CR)
+                denom = np.sum(S_F_arr)
+                if denom > 0:
+                    mu_F = (1.0 - c) * mu_F + c * np.sum(S_F_arr ** 2) / denom
+                mu_CR = (1.0 - c) * mu_CR + c * np.mean(S_CR_arr)
+                mu_F = float(np.clip(mu_F, 0.1, 1.0))
+                mu_CR = float(np.clip(mu_CR, 0.0, 1.0))
+
+            # Controller reward / transition storage
+            if self.controller is not None and train:
+                improved = 1.0 if gbest_f < prev_gbest_f else 0.0
+                next_obs = {'iteration': iteration, 'evals': evals, 'gbest_f': gbest_f,
+                            'initial_gbest_f': initial_gbest_f, 'max_evals': self.max_evals}
+                if hasattr(self.controller, 'store_reward'):
+                    self.controller.store_reward(improved, next_obs, (evals >= self.max_evals))
+            prev_gbest_f = gbest_f
+
+        self.stats = {
+            'gbest': gbest.tolist(),
+            'gbest_f': float(gbest_f),
+            'evals': int(evals),
+            'iterations': int(iteration),
+            'initial_gbest_f': initial_gbest_f,
+        }
+        return gbest.tolist(), self.stats
