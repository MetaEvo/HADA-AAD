+        keep_indices = np.setdiff1d(np.arange(current_n), worst_indices)
+        n_keep = len(keep_indices)
+        if n_keep > 0:
+            pop[:n_keep] = pop[keep_indices]
+            fitness[:n_keep] = fitness[keep_indices]
+        if n_keep < target_n:
+            local_best_idx = int(np.argmin(fitness[:max(1, n_keep)]))
+            for j in range(n_keep, target_n):
+                pop[j] = pop[local_best_idx].copy()
+                fitness[j] = fitness[local_best_idx]
+        current_n = target_n
+```
