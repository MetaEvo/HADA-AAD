diff --git a/metabbo/param_controller.py b/metabbo/param_controller.py
index 054f914..5631068 100644
--- a/metabbo/param_controller.py
+++ b/metabbo/param_controller.py
@@ -151,4 +151,78 @@ class AdaptiveDEController(ParamController):
         return {'F': float(F), 'CR': float(CR), 'strategy': strategy,
                 'epsilon': float(epsilon),
                 'pbest_rate': float(pbest_rate),
+                'archive_prob': float(archive_prob)}
+
+
+class SHADEAdaptiveController(ParamController):
+    """Adaptive DE controller with SHADE-style success-history memory.
+
+    Maintains a small memory of successful (F, CR) values. Parameters are
+    sampled from Cauchy/Gaussian distributions around a randomly chosen memory
+    slot, providing strong exploration early and refined exploitation later.
+    The memory is updated with Lehmer means of successful parameters weighted
+    by fitness improvement, similar to SHADE.
+    """
+    def __init__(self, memory_size=10, f_start=0.9, f_end=0.2,
+                 cr_start=0.9, cr_end=0.4):
+        self.memory_size = memory_size
+        self.f_start = f_start
+        self.f_end = f_end
+        self.cr_start = cr_start
+        self.cr_end = cr_end
+
+    def reset(self, problem_meta: Dict[str, Any]) -> None:
+        self.it = 0
+        self.mem_F = np.full(self.memory_size, 0.5)
+        self.mem_CR = np.full(self.memory_size, 0.9)
+        self.mem_idx = 0
+        self.last_gbest = None
+        self.stagnation_count = 0
+
+    def step(self, observation: Dict[str, Any]) -> Dict[str, float]:
+        self.it = observation.get('iteration', self.it + 1)
+        max_iter = max(1, int(observation.get('max_evals', 10000) / 100))
+        t = min(1.0, float(self.it) / max_iter)
+
+        # Progress-based floor/ceil bounds for F and CR
+        f_ref = self.f_start * (1 - t) + self.f_end * t
+        cr_ref = self.cr_start * (1 - t) + self.cr_end * t
+
+        # Sample from a random memory slot with heavy-tailed noise
+        k = int(np.random.randint(0, self.memory_size))
+        F = float(np.clip(self.mem_F[k] + 0.1 * np.random.standard_cauchy(), 0.0, 1.0))
+        CR = float(np.clip(self.mem_CR[k] + 0.1 * np.random.randn(), 0.0, 1.0))
+
+        # Blend with progress reference to guarantee systematic exploration->exploitation
+        F = 0.5 * F + 0.5 * f_ref
+        CR = 0.5 * CR + 0.5 * cr_ref
+
+        # Stagnation detection: when the best does not improve, inject diversity
+        current_gbest = observation.get('gbest_f', None)
+        prev_gbest = self.last_gbest
+        improved = False
+        if current_gbest is not None and self.last_gbest is not None:
+            if current_gbest < self.last_gbest - 1e-12:
+                improved = True
+                self.stagnation_count = 0
+            else:
+                self.stagnation_count += 1
+        self.last_gbest = current_gbest
+
+        if self.stagnation_count > 5:
+            F = min(1.0, F + 0.15)
+            CR = min(1.0, CR + 0.15)
+            self.stagnation_count = 0
+
+        # On improvement, record the current parameters into success memory
+        if current_gbest is not None and prev_gbest is not None and improved:
+            self.mem_F[self.mem_idx] = F
+            self.mem_CR[self.mem_idx] = CR
+            self.mem_idx = (self.mem_idx + 1) % self.memory_size
+
+        # JADE-style pbest/archive schedule
+        pbest_rate = 0.4 * (1.0 - t) + 0.1 * t
+        archive_prob = 0.7 * (1.0 - t) + 0.3 * t
+
+        return {'F': float(F), 'CR': float(CR), 'pbest_rate': float(pbest_rate),
                 'archive_prob': float(archive_prob)}
