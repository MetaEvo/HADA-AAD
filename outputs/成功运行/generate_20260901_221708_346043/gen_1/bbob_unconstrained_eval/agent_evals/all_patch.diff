+class JADEAdaptiveController(ParamController):
+    """Adaptive controller for JADE-style differential evolution.
+
+    Provides F, CR, pbest_ratio, and archive_mult parameters. F and CR are
+    sampled from a decaying range to balance exploration and exploitation.
+    The p-best ratio shrinks over time to focus on top solutions, and the
+    archive multiplier increases to retain more diversity. Stagnation boosts
+    both F and CR and expands the archive to escape local optima.
+    """
+    def __init__(self, f_start=0.9, f_end=0.2, cr_start=0.9, cr_end=0.2,
+                 pbest_start=0.3, pbest_end=0.05,
+                 archive_mult_start=1.0, archive_mult_end=3.0,
+                 stagnation_boost=0.15):
+        self.f_start = f_start
+        self.f_end = f_end
+        self.cr_start = cr_start
+        self.cr_end = cr_end
+        self.pbest_start = pbest_start
+        self.pbest_end = pbest_end
+        self.archive_mult_start = archive_mult_start
+        self.archive_mult_end = archive_mult_end
+        self.stagnation_boost = stagnation_boost
+
+    def reset(self, problem_meta: Dict[str, Any]) -> None:
+        self.it = 0
+        self.stagnation_count = 0
+        self.last_gbest = None
+
+    def step(self, observation: Dict[str, Any]) -> Dict[str, float]:
+        # Defensive fallback so step() works even if reset() was not called.
+        self.it = observation.get('iteration', getattr(self, 'it', 0) + 1)
+        max_iter = max(1, int(observation.get('max_evals', 10000) / 100))
+        t = min(1.0, float(self.it) / max_iter)
+
+        # Smooth interpolation from exploration to exploitation.
+        F = self.f_start * (1.0 - t) + self.f_end * t
+        CR = self.cr_start * (1.0 - t) + self.cr_end * t
+        pbest_ratio = self.pbest_start * (1.0 - t) + self.pbest_end * t
+        archive_mult = self.archive_mult_start * (1.0 - t) + self.archive_mult_end * t
+
+        # Stagnation detection: boost diversity if no improvement for a while.
+        current_gbest = observation.get('gbest_f', None)
+        # Defensive getattr so step() also works without an explicit reset().
+        last_gbest = getattr(self, 'last_gbest', None)
+        stagnation_count = getattr(self, 'stagnation_count', 0)
+        if current_gbest is not None and last_gbest is not None:
+            if current_gbest < last_gbest - 1e-12:
+                stagnation_count = 0
+            else:
+                stagnation_count += 1
+        self.last_gbest = current_gbest
+        self.stagnation_count = stagnation_count
+
+        if stagnation_count > 4:
+            F = min(1.0, F + self.stagnation_boost)
+            CR = min(1.0, CR + self.stagnation_boost)
+            pbest_ratio = min(0.5, pbest_ratio + 0.05)
+            archive_mult = min(5.0, archive_mult + 0.5)
+            self.stagnation_count = 0
+
+        return {'F': float(F), 'CR': float(CR),
+                'pbest_ratio': float(pbest_ratio),
+                'archive_mult': float(archive_mult)}
